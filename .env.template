# Plantilla de variables de entorno.
#
# Uso:  cp .env.template .env    y luego completá los valores reales.
# El archivo .env está en el .gitignore y NO se sube al repositorio.

DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# Puerto de TU MÁQUINA para conectarte a la base con DBeaver/psql.
# Si ya tenés un Postgres local usando el 5432, poné otro (ej: 5433).
# Adentro de Docker los contenedores siempre se hablan por el 5432,
# así que cambiar esto NO rompe la conexión de la app con la base.
DB_PORT=5432
