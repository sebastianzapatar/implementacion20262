# Plantilla de variables de entorno.
#
# Uso:  cp .env.template .env    y luego completá los valores reales.
# El archivo .env está en el .gitignore y NO se sube al repositorio.

DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# Puerto de TU MÁQUINA para conectarte a la base con DBeaver/psql.
# Si ya tenés un Postgres local usando el 5432, poné otro (ej: 5433).
# Adentro de Docker los contenedores siempre se hablan por el 5432,
# así que cambiar esto NO rompe la conexión de la app con la base.
DB_PORT=5432


# =============================================================================
# ¿Y DB_URL? -> NO va acá para el perfil "docker"
# =============================================================================
# application-docker.yml pide ${DB_URL}, pero esa variable NO se define en este
# archivo: la arma compose.yml a partir de DB_NAME.
#
#     compose.yml:  DB_URL=jdbc:postgresql://db:5432/${DB_NAME}
#
# Dos motivos para dejarlo así:
#
# 1) El host y el puerto son fijos dentro de la red de Docker: "db" es el nombre
#    del servicio de Postgres y el puerto es SIEMPRE 5432, el interno. Si el
#    DB_URL se escribiera a mano acá, tarde o temprano alguien le metería
#    ${DB_PORT} (el puerto del HOST) y la app fallaría con "connection refused".
#
# 2) Este .env solo sirve para que Compose reemplace los ${...} del compose.yml;
#    sus variables NO se inyectan solas al contenedor. Como compose.yml ya fija
#    el valor de DB_URL en su bloque "environment:", un DB_URL escrito acá
#    quedaría IGNORADO en silencio. Parecería configurar la conexión sin hacerlo.
#
# Para cambiar la base en Docker: cambiá DB_NAME acá arriba, no el DB_URL.


# =============================================================================
# PERFIL "prod"  ->  acá DB_URL SÍ se define a mano
# =============================================================================
# application-prod.yml exige estas tres variables y NO les da valor por defecto:
# si falta una, la app no arranca (es a propósito, mejor eso que conectarse a la
# base equivocada). Fuera de Docker no hay nadie que arme la URL, así que va
# completa: host, puerto y nombre de la base reales del servidor.
#
# OJO CON EL NOMBRE: prod pide DB_USERNAME, con "NAME" al final. Las de arriba
# se llaman DB_USER porque las consume compose.yml. No son la misma variable.
#
# Descomentá y completá solo si vas a correr con SPRING_PROFILES_ACTIVE=prod.
# Estos valores son credenciales reales: nunca los subas al repo.
#
# DB_URL=jdbc:postgresql://host-del-servidor:5432/nombre_base
# DB_USERNAME=usuario_de_prod
# DB_PASSWORD=contraseña_de_prod

# Puerto en el que escucha la app. Si no lo definís, application.yml usa 8080.
# SERVER_PORT=8080
